# =============================================================================
# TradCopilot — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development and fill in real values.
# In production, set the same keys in your hosting provider (Vercel Project
# Settings → Environment Variables). NEVER commit real secrets. Every value
# below is a non-functional placeholder.
#
# Required for the app to boot in production are marked [REQUIRED]. Optional /
# provider keys may be left empty — the app runs with whichever providers are
# configured (see lib/startup.ts for the boot-time status banner).
# =============================================================================

# ── Core app ──────────────────────────────────────────────────────────────────
# Public canonical site URL (used by sitemap, robots, and Stripe callbacks). No trailing slash.
# In production, this should be: https://tradcopilot.com
# In local development (.env.local), use: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Supabase (Auth + Storage) [REQUIRED in production] ───────────────────────
# Project URL + anon public key from Supabase → Project Settings → API.
# Server-side (lib/supabase/server.ts, middleware.ts) fails fast if these are
# missing in production. The anon key is public by design; it is NOT a secret.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# ── Database (PostgreSQL / Supabase) [REQUIRED in production] ────────────────
# Prisma runtime (lib/prisma.ts) validates this on the real-client path.
# Set USE_DB_MOCK=true ONLY for CI / local builds that must run without a DB.
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"
USE_DB_MOCK=""

# ── Encryption (AES-256-GCM, at-rest API keys) [REQUIRED in production] ──────
# 64-char hex string (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ── Demo sessions (HMAC-signed cookie) [REQUIRED in production] ──────────────
# 32+ char random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_SECRET=""

# ── Machine-to-machine secrets ───────────────────────────────────────────────
# Vercel Cron bearer for /api/cron/* (constant-time checked).
CRON_SECRET=""
# Admin prewarm endpoint (/api/v1/admin/prewarm).
ADMIN_SECRET=""

# ── Stripe (billing) [REQUIRED for paid plans] ───────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Price ID for the PRO plan.
STRIPE_PRICE_ID=""
# DEV ONLY: accept unsigned webhooks. Refuses to start in production if true.
ALLOW_UNVERIFIED_STRIPE_WEBHOOKS=""

# ── Microsoft Clarity (analytics, optional) ──────────────────────────────────
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
NEXT_PUBLIC_CLARITY_ID=""

# ── AI providers (any subset; sequential fallback Groq → NVIDIA → Gemini) ────
GROQ_API_KEY=""
GROQ_API_KEY_2=""
GROQ_PREMIUM_API_KEY=""
NVIDIA_API_KEY=""
NVIDIA_PREMIUM_API_KEY=""
NVIDIA_BASE_URL=""
GEMINI_API_KEY=""
GEMINI_PREMIUM_API_KEY=""
OPENAI_API_KEY=""

# ── Market data / news providers (any subset) ────────────────────────────────
TWELVEDATA_API_KEY=""
FINNHUB_API_KEY=""
NEWS_API_KEY=""
NEWSAPI_API_KEY=""