# ──────────────────────────────────────────────────────────────────────
# TradePilot — Environment variable template
# Copy this to `.env.local` and fill in real values.
# Never commit `.env.local` to git.
# ──────────────────────────────────────────────────────────────────────

# ── Supabase (auth + Postgres) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── Encryption (used for sensitive at-rest columns) ───────────────────
ENCRYPTION_KEY=

# ── AI providers ──────────────────────────────────────────────────────
# Order in the race:
#   1. Groq Key #1 (primary, fastest)
#   2. Groq Key #2 (failover if #1 returns 401/403/429/timeout)
#   3. NVIDIA NIM
#   4. Gemini
#   5. OpenAI (optional)
#
# Groq Key #2 is optional. If unset, only Key #1 fires in the race.
# Both keys are kept in the same race; the first to return a valid
# response wins. A key that 429s is skipped for 60s (cooldown).
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_PREMIUM_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
GEMINI_API_KEY=
GEMINI_PREMIUM_API_KEY=
OPENAI_API_KEY=

# ── Market data providers ────────────────────────────────────────────
# Routing rules:
#   BTC/USD, ETH/USD, SOL/USD, EUR/USD, GBP/USD  →  Binance → Coinbase
#   USD/JPY, XAU/USD, NASDAQ, S&P500             →  TwelveData
# Free tier TwelveData: 8 req/min, 800 req/day.
TWELVEDATA_API_KEY=

# ── News providers ────────────────────────────────────────────────────
# Both fetched in parallel and merged with cross-source dedupe.
#   Finnhub  →  primary news (60 req/min free)
#   NewsAPI  →  fallback news    (100 req/day free)
# NEWSAPI_API_KEY is accepted as an alias for NEWS_API_KEY.
FINNHUB_API_KEY=
NEWS_API_KEY=
NEWSAPI_API_KEY=

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email (password reset, alerts) ────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Misc ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=
SENTRY_DSN=
LOG_LEVEL=info
